# Phase 1 is intentionally synthetic-only. LIVE must remain disabled until a
# reviewed provider adapter and credentials are available.
DATA_MODE=SYNTHETIC
DATABASE_URL=postgresql://cardscout:change-me@localhost:5432/cardscout

# Reserved for the disabled eBay adapter. Never prefix secrets with VITE_.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Public deployment origin, used for absolute social metadata after publishing.
VITE_PUBLIC_SITE_ORIGIN=

