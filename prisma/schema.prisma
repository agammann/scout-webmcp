generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataMode {
  LIVE
  SANDBOX
  SYNTHETIC
}

enum TierKind {
  RAW
  GRADED
}

model PokemonCard {
  id          String        @id @default(cuid())
  canonicalKey String       @unique
  name        String
  setName     String
  setCode     String
  cardNumber  String
  releaseYear Int
  rarity      String
  variant     String
  finish      String
  edition     String
  language    String
  printing    String
  promo       Boolean       @default(false)
  listings    MarketplaceListing[]
  sales       Sale[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([setCode, cardNumber, language])
}

model Seller {
  id                   String        @id @default(cuid())
  providerId           String
  platformSellerId     String
  dataMode             DataMode
  displayName          String
  feedbackPercent      Decimal?
  feedbackCount        Int?
  transactionCount     Int?
  accountCreatedAt     DateTime?
  recentPositive       Int?
  recentNeutral        Int?
  recentNegative       Int?
  returnsAccepted      Boolean?
  verified             Boolean?
  relevantSalesCount   Int?
  listingQuality       Int?
  sourceRetrievedAt    DateTime
  listings             MarketplaceListing[]
  ratings              SellerRating[]

  @@unique([providerId, platformSellerId, dataMode])
}

model MarketplaceListing {
  id                   String      @id @default(cuid())
  providerId           String
  externalId           String
  dataMode             DataMode
  cardId               String
  card                 PokemonCard @relation(fields: [cardId], references: [id])
  sellerId             String
  seller               Seller      @relation(fields: [sellerId], references: [id])
  tierKind             TierKind
  rawCondition         String?
  gradingCompany       String?
  grade                Decimal?
  certificationNumber  String?
  title                String
  description          String
  sourceUrl             String?
  currency             String
  priceCents           Int
  shippingCents        Int?
  imageCount           Int
  usesStockPhoto       Boolean?
  returnsAccepted      Boolean?
  listingType          String
  endsAt               DateTime?
  observedAt           DateTime
  sourceRetrievedAt    DateTime
  assessments          DealAssessment[]

  @@unique([providerId, externalId, dataMode])
  @@index([cardId, tierKind, gradingCompany, grade, rawCondition, dataMode])
}

model Sale {
  id                  String      @id @default(cuid())
  providerId          String
  externalId          String
  dataMode            DataMode
  cardId              String
  card                PokemonCard @relation(fields: [cardId], references: [id])
  tierKind            TierKind
  rawCondition        String?
  gradingCompany      String?
  grade               Decimal?
  certificationNumber String?
  currency            String
  priceCents          Int
  shippingCents       Int?
  soldAt              DateTime
  title               String
  sourceUrl            String?
  sourceRetrievedAt   DateTime

  @@unique([providerId, externalId, dataMode])
  @@index([cardId, tierKind, gradingCompany, grade, rawCondition, soldAt, dataMode])
}

model SellerRating {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  providerId  String
  externalId  String
  dataMode    DataMode
  sentiment   String
  reviewText  String?
  occurredAt  DateTime?

  @@unique([providerId, externalId, dataMode])
}

model MarketSnapshot {
  id                 String   @id @default(cuid())
  dataMode           DataMode
  cardId             String
  tierKey            String
  currency           String
  asOf               DateTime
  count30            Int
  count90            Int
  median30Cents      Int?
  median90Cents      Int?
  weightedMedianCents Int?
  low90Cents         Int?
  high90Cents        Int?
  confidenceScore    Int
  methodologyVersion String

  @@unique([dataMode, cardId, tierKey, asOf])
}

model DealAssessment {
  id                  String             @id @default(cuid())
  listingId           String
  listing             MarketplaceListing @relation(fields: [listingId], references: [id])
  dataMode            DataMode
  score               Int?
  marketDealScore     Int?
  sellerTrustScore    Int?
  classification      String
  totalCents          Int
  percentFromMedian90 Decimal?
  reasons             Json
  risks               Json
  methodologyVersion  String
  assessedAt          DateTime           @default(now())

  @@index([dataMode, score, assessedAt])
}

